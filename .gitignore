# Claude settings — local-only, EXCEPT shared path-scoped rules (operational docs, must travel with the repo like CLAUDE.md)
# and the shared guard hooks + the settings.json that wires them (settings.local.json stays per-machine)
.claude/*
!.claude/rules/
!.claude/hooks/
!.claude/settings.json
# Shared workflow: the /intent skill and the intent-reviewer subagent. Other skills under .claude/skills/ are per-machine installs and stay ignored.
!.claude/agents/
!.claude/skills/
.claude/skills/*
!.claude/skills/intent/

# Internal-only notes — never tracked
.private/

# Per-machine session state (codex, etc.)
.context/

# Secrets / credentials — prevent accidental commit
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
id_rsa*
id_ed25519*
.htpasswd

# Temporary files
*.backup
*.bak
*.tmp
*.temp
