{
  "name": "emelmujiro",
  "version": "1.0.0",
  "description": "Emelmujiro - AI Education and Consulting Company Official Website",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "security:setup": "bash scripts/install-security-tools.sh",
    "security:dependencies": "node scripts/scan-dependencies.ts",
    "security:images": "node scripts/scan-running-images.ts",
    "security:scheduled": "node scripts/scheduled-security.ts",
    "security:report": "node scripts/security-report.ts",
    "check:scripts": "npm run type-check:scripts --workspace=frontend && node --test scripts/tests/*.test.ts && python3 scripts/test_backup_verify.py",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:clean": "./scripts/ports.sh --kill && npm run dev",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "cd backend && uv run python manage.py runserver",
    "build": "npm run build --workspace=frontend",
    "knip": "knip",
    "prepare": "husky",
    "spell": "cspell --no-progress \"**\" \".claude/rules/**\" \".claude/hooks/**\" \".claude/skills/intent/**\" \".claude/agents/**\" \".github/**\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cspell": "^10.4.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.5",
    "@tiptap/core": "^3.32.0",
    "brace-expansion": "^5.0.9",
    "chromium-bidi": {
      "zod": "4.6.7"
    },
    "minimatch": ">=10.2.1",
    "tmp": "0.2.7",
    "@lhci/cli": {
      "js-yaml": "4.3.2",
      "uuid": "11.1.1"
    },
    "get-uri": {
      "basic-ftp": "6.2.3"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
