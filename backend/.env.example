# ============================================
# Emelmujiro Backend — Environment Variables
# ============================================
# For local dev: copy to .env
# For Docker prod: copy to .env.production and set real SECRET_KEY

# ---- Required ----
SECRET_KEY=your-secret-key-here-minimum-50-characters
ALLOWED_HOSTS=emelmujiro.com,api.emelmujiro.com,localhost,127.0.0.1

# ---- Database ----
# Leave DATABASE_URL empty to use SQLite (default, recommended for Mac Mini)
# Set to a PostgreSQL URL to use an external PostgreSQL server
DATABASE_URL=
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Core ----
DEBUG=False
CORS_ALLOWED_ORIGINS=https://emelmujiro.com
CSRF_TRUSTED_ORIGINS=https://emelmujiro.com,https://api.emelmujiro.com

# ---- Email (optional — contact form uses Google Form iframe for now) ----
# EMAIL_HOST is hardcoded to smtp.gmail.com in settings.py (not configurable via env)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ---- Security (production) ----
# Cloudflare owns the http->https upgrade; behind the tunnel every request
# reaches Django as http, so SECURE_SSL_REDIRECT=True loops. HSTS is one day,
# no subdomains or preload (docs/intents/infra/hsts.md); these match the code
# defaults.
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_SSL_REDIRECT=False

# ---- reCAPTCHA (optional) ----
# RECAPTCHA_PUBLIC_KEY=
# RECAPTCHA_PRIVATE_KEY=

# ---- Monitoring (optional) ----
ADMIN_EMAIL=admin@emelmujiro.com
